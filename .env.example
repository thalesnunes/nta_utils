# Telegram Bot Token from @BotFather (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of allowed Telegram user IDs for access control (Optional)
TELEGRAM_ALLOWED_USERS=123456789,987654321

# Google Calendar ID for /folgas and /escala commands (Required for calendar features)
GCAL_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Path to Google service account credentials JSON (Optional, default: /app/credentials/credentials.json)
GCAL_CREDENTIALS_PATH=/app/credentials/credentials.json

# Google AI Studio API Key for schedule image analysis with Gemini (Required for /escala)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (Optional, default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
